# Smart City AI Agent - Environment Configuration
# Copy to .env: copy .env.example .env

# ── App Settings ──────────────────────────────────────────
APP_NAME=Smart City AI Agent
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# ── Default Location (change to adapt for any city) ───────
DEFAULT_LATITUDE=51.5074
DEFAULT_LONGITUDE=-0.1278
DEFAULT_LOCATION_NAME=Central London

# ── Bounding Box (Greater London) ─────────────────────────
BBOX_MIN_LAT=51.28
BBOX_MIN_LON=-0.51
BBOX_MAX_LAT=51.69
BBOX_MAX_LON=0.33

# ── TfL API (optional - higher rate limits with key) ──────
TFL_APP_KEY=

# ── TomTom API ────────────────────────────────────────────
TOMTOM_API_KEY=

# ── OpenAQ API ────────────────────────────────────────────
OPENAQ_API_KEY=

# ── Google Gemini ─────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Cache Settings ────────────────────────────────────────
CACHE_TTL_SECONDS=300
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=2
